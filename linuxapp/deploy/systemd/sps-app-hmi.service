[Unit]
Description=SPS HMI - QML touchscreen kiosk
Documentation=https://github.com/anomalyco/SPS

Requires=sps-protocol-router.service sps-authentication.service sps-auto-engine.service
Wants=dbus.service sps-network-manager.service sps-ota-manager.service

After=dbus.service
After=sps-protocol-router.service
After=sps-authentication.service
After=sps-auto-engine.service
After=sps-network-manager.service
After=sps-ota-manager.service

PartOf=sps.target

[Service]
Type=simple
WorkingDirectory=/opt/sps
ExecStart=/opt/sps/bin/appHmi
Restart=on-failure
RestartSec=3

Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=SPS_CONFIG_DIR=/opt/sps/config

[Install]
WantedBy=sps.target