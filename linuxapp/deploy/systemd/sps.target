[Unit]
Description=SPS Services Stack
Documentation=https://github.com/anomalyco/SPS

Requires=dbus.service
After=dbus.service

Wants=sps-protocol-router.service
Wants=sps-authentication.service
Wants=sps-network-manager.service
Wants=sps-ota-manager.service
Wants=sps-auto-engine.service
Wants=sps-app-hmi.service

[Install]
WantedBy=multi-user.target