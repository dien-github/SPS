[Unit]
Description=SPS Network Manager - MQTT, WoL, connectivity
Documentation=https://github.com/anomalyco/SPS
Wants=dbus.service network-online.target
After=dbus.service network-online.target
PartOf=sps.target

[Service]
Type=simple
WorkingDirectory=/opt/sps
ExecStart=/opt/sps/bin/svcNetworkManager
Restart=on-failure
RestartSec=3

Environment=SPS_CONFIG_DIR=/opt/sps/config
Environment=SPS_WOL_BROADCAST=255.255.255.255
Environment=SPS_WOL_PORT=9

[Install]
WantedBy=sps.target